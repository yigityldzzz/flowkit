# ── API (apps/api/.env) ────────────────────────────────────────────────
DATABASE_URL="postgresql://flowkit:PASSWORD@localhost:5432/flowkitdb"
JWT_SECRET="replace-with-a-long-random-string-min-64-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-string-min-64-chars"
NODE_ENV="production"
PORT=4000
ALLOWED_ORIGINS="https://flowkit.digitaladexpert.de"

# ── Web (apps/web/.env.local) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://flowkit.digitaladexpert.de"
